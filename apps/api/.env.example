# Copy to .env and fill in. Never commit the filled copy (D5 / checklist B.1).
# Names only appear in the repository; values live here and in the host's
# environment settings.

NODE_ENV=development
PORT=4000

# Comma-separated. No wildcard, in any environment.
ALLOWED_ORIGINS=http://localhost:5173

# The public site's own origin. Used to build absolute sitemap URLs, so this is
# the site, never the API.
PUBLIC_SITE_URL=http://localhost:5173

# Public write routes (contact endpoint): window in ms, ceiling per window.
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=20

MAX_UPLOAD_BYTES=5242880

# Skips the admin sign-in so the portal can be used locally without an account.
# Ignored outside development: the deployed API is reachable by anyone, and an
# unauthenticated mutation route there lets a stranger delete the portfolio.
ADMIN_AUTH_BYPASS=true

# --- Supabase (required from Phase 3 onward; unused while the site runs on mock data) ---

# Pooled connection used by Prisma at runtime.
DATABASE_URL=
# Direct connection, used for migrations where the pooled URL cannot run them.
DIRECT_URL=

SUPABASE_URL=
# Privileged. Server-side only — this must never reach a client bundle.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
