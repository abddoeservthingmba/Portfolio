# Copy to .env and fill in. Never commit the filled copy.
#
# WARNING: everything prefixed VITE_ is compiled into the public bundle and is
# readable by anyone who views the site. Only the anonymous key may carry that
# prefix — a service-role key here must be treated as disclosed and rotated.

VITE_API_BASE_URL=http://localhost:4000/api/v1

# --- Supabase (required from Phase 4, for the administrator sign-in flow) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
